# Copy to server/.env (git-ignored). Never commit real values.
PORT=5000

# Allowed browser origin(s) for CORS, comma-separated, no trailing slash.
# Production: your frontend's Vercel URL, e.g. https://your-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string (server-side only). Use your provider's pooled URL with SSL,
# e.g. postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Leave empty locally to use the embedded Postgres in server/data/pglite.
DATABASE_URL=

# Google AI Studio key for Gemma (server-side only, never commit)
GOOGLE_API_KEY=
# Optional: override model (default gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it
